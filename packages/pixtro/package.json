{
  "name": "pixtro",
  "version": "0.1.0",
  "description": "Retro pixel mascot generation engine. Deterministic, seed-driven, hand-authored parts.",
  "keywords": [
    "pixel-art",
    "mascot",
    "avatar",
    "generator",
    "sprite",
    "gif",
    "retro",
    "procedural"
  ],
  "license": "MIT",
  "author": "restuindrawan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restuindrawan/pixtro.git",
    "directory": "packages/pixtro"
  },
  "homepage": "https://github.com/restuindrawan/pixtro#readme",
  "bugs": "https://github.com/restuindrawan/pixtro/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "bin": {
    "pixtro": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "cli": "node src/cli.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
