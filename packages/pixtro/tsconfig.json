{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // Node strips types at runtime rather than compiling them, so the syntax we
    // write has to survive erasure. These two flags make tsc reject anything
    // that would need codegen (enum, namespace, parameter properties).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "*.ts"]
}
